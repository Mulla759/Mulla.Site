# Copy to backend/.env and fill in. backend/.env is gitignored (never commit secrets).

# --- TMDB (movie posters) ---------------------------------------------------
# Free, non-commercial. Get a key: https://www.themoviedb.org/settings/api
# Use ONE of the two. The v3 API key (query param) is the simplest.
TMDB_API_KEY=
# TMDB_READ_TOKEN=          # v4 "Read Access Token" alternative (Bearer)
# TMDB_POSTER_SIZE=w500     # w342 | w500 | w780 | original

# --- Letterboxd -------------------------------------------------------------
LETTERBOXD_USER=mulla759

# --- Tuning -----------------------------------------------------------------
# MAX_ITEMS=12              # how many recent films to publish
